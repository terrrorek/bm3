"#version 430 core\n"
"layout( location = 0 ) in vec3 vaPosition;\n"
"layout( location = 1 ) in vec2 vaUV;\n"
"out vec2 UV;\n"
"\n"
"uniform mat4 model;\n"
"uniform mat4 projection;\n"
"\n"
"uniform ivec2 screen_wh;\n"
"uniform ivec4 xywh;\n"
"uniform ivec4 tex_xywh;\n"
"uniform ivec2 raw_wh;\n"
"\n"
"void main()\n"
"{\n"
"   vec2 sUV = vec2("
"      (tex_xywh.z / screen_wh.x) / (xywh.z / screen_wh.x),"
"      (tex_xywh.w / screen_wh.y) / (xywh.w / screen_wh.y) );\n"
"   vec2 oUV = vec2( tex_xywh.x / raw_wh.x, tex_xywh.y / raw_wh.y );\n"
"   UV = (vaUV * sUV) + oUV;\n"
//"   UV = vaUV;\n"
"   gl_Position = projection * model * vec4(vaPosition, 1.0);\n"
"}\n"

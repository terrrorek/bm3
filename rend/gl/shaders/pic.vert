"#version 430 core\n"
"layout( location = 0 ) in vec3 vaPosition;\n"
"layout( location = 1 ) in vec2 vaUV;\n"
"out vec2 UV;\n"
"\n"
"uniform mat4 model;\n"
"uniform mat4 projection;\n"
"\n"
"uniform vec2 top_uv;\n"
"uniform vec2 down_uv;\n"
"\n"
"void main()\n"
"{\n"
"   const vec2 uvTables[4] = {\n"
"      vec2( down_uv.x, top_uv.y  ),\n"
"      vec2( down_uv.x, down_uv.y ),\n"
"      vec2( top_uv.x,  down_uv.y ),\n"
"      vec2( top_uv.x,  top_uv.y  ),\n"
"   };\n"
"   UV = uvTables[gl_VertexID];\n"
"   gl_Position = projection * model * vec4(vaPosition, 1.0);\n"
"}\n"
